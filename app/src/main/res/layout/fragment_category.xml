<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:orientation="vertical">

    <!-- 헤더: 카테고리 제목 + 우측 상단 검색 버튼 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/primary_color"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="카테고리"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <!-- 우측 상단 검색 버튼 -->
        <TextView
            android:id="@+id/btn_category_search"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_page_btn_filled"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="🔍 전체보기"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- 선택된 경로 표시 (대분류 > 중분류) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="@color/primary_light"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/tv_category_path"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="대분류 선택 후 검색 버튼을 누르면 해당 카테고리 상품을 전부 볼 수 있습니다."
            android:textColor="@color/primary_color"
            android:textSize="11sp"
            android:ellipsize="end"
            android:maxLines="1"/>
    </LinearLayout>

    <!-- 대분류 + 중분류 + 소분류 3열 구조 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- 대분류 (왼쪽) -->
        <ScrollView
            android:layout_width="95dp"
            android:layout_height="match_parent"
            android:background="@color/white"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/main_category_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </ScrollView>

        <View android:layout_width="1dp" android:layout_height="match_parent"
            android:background="@color/divider_color"/>

        <!-- 중분류 (가운데) -->
        <ScrollView
            android:layout_width="110dp"
            android:layout_height="match_parent"
            android:background="@color/bg_main"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/mid_category_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </ScrollView>

        <View android:layout_width="1dp" android:layout_height="match_parent"
            android:background="@color/divider_color"/>

        <!-- 소분류 (오른쪽) -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:background="@color/white"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/sub_category_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
